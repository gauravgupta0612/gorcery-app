# Backend HTTP port
PORT=8095

# Copy to .env (never commit .env) and export before running, e.g.  set -a; source .env; set +a
DB_URL=jdbc:postgresql://localhost:5432/gola_grocery
DB_USERNAME=gola
DB_PASSWORD=change-me

# Generate with:  openssl rand -base64 48
JWT_SECRET=

# First admin account is created on startup if it does not exist
ADMIN_PHONE=9999999999
ADMIN_EMAIL=admin@golagrocery.example
ADMIN_PASSWORD=

# Local development helpers
OTP_DEV_ECHO=true
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./uploads
SEED_IMAGES_DIR=../database/seed-images

# Payments: "mock" for local dev, "razorpay" for real payments
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging service-account JSON path (optional)
FIREBASE_CREDENTIALS_FILE=
