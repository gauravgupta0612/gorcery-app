<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gola" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="colorPrimary">@color/gola_green</item>
        <item name="colorAccent">@color/gola_yellow</item>
    </style>

    <style name="Theme.Gola.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gola_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Gola</item>
    </style>
</resources>
